meta {
  name: Register device token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/customer/device-tokens
  body: json
  auth: inherit
}

body:json {
  {
    "token": "{{fcm_token}}",
    "platform": "android",
    "device_id": "bruno-device",
    "device_name": "Bruno"
  }
}

script:pre-request {
  bru.setVar("fcm_token", "bruno-fake-fcm-" + require("crypto").randomBytes(24).toString("hex"));
}

script:post-response {
  if (res.getStatus() === 200) { bru.setVar("device_token_id", String(res.getBody().data.device_token.id)); }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("token never echoed in full", function () {
    expect(JSON.stringify(res.getBody())).to.not.contain(bru.getVar("fcm_token"));
  });
}

docs {
  A random fake token: no push is delivered unless the server has real FCM credentials and WAFFRLI_PUSH_ENABLED=true.
}
