meta {
  name: Register - first and last name required
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/customer/auth/register
  body: json
  auth: none
}

body:json {
  {
    "registration_token": "{{registration_token}}",
    "first_name": "Bruno"
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}
