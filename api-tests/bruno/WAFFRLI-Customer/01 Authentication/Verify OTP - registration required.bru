meta {
  name: Verify OTP - registration required
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/customer/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{new_phone}}",
    "code": "{{otp_code}}",
    "device_id": "bruno-new-device"
  }
}

script:post-response {
  if (res.getStatus() === 200) { bru.setVar("registration_token", res.getBody().data.registration_token); }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });

  test("no account yet: a short-lived registration token, no bearer token", function () {
    const d = res.getBody().data;
    expect(d.status).to.equal("registration_required");
    expect(d.registration_token).to.be.a("string").and.not.empty;
    expect(d.token).to.equal(undefined);
  });
}
