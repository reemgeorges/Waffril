meta {
  name: Recovery - request (same answer for any phone)
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/v1/customer/auth/recovery/request
  body: json
  auth: none
}

body:json {
  {
    "phone": "+12025559999"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("does not reveal whether a recoverable account exists", function () {
    expect(res.getBody().data.message).to.be.a("string");
  });
}
