meta {
  name: Recovery - verify (account restored)
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/v1/customer/auth/recovery/verify
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{new_phone}}",
    "code": "{{otp_code}}",
    "device_id": "bruno-new-device"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("restored and signed in", function () {
    expect(res.getBody().data.token).to.be.a("string").and.not.empty;
    expect(res.getBody().data.user.account_status).to.equal("active");
  });
}
