meta {
  name: New account - set an email
  type: http
  seq: 13
}

patch {
  url: {{base_url}}/api/v1/customer/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{new_token}}
}

body:json {
  {
    "email": "{{new_email}}"
  }
}

script:pre-request {
  bru.setVar("new_email", "bruno+" + Date.now() + "@example.test");
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  Runs as the account registered above (new_token), never the demo customer.
}
