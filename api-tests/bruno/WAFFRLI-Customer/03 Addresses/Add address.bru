meta {
  name: Add address
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/customer/addresses
  body: json
  auth: inherit
}

body:json {
  {
    "label": "Bruno office",
    "address_line": "Bruno test street",
    "lat": {{latitude}},
    "lng": {{longitude}}
  }
}

script:post-response {
  if (res.getStatus() === 200) { bru.setVar("address_id", String(res.getBody().data.address.id)); }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("city resolved from coordinates", function () {
    expect(res.getBody().data.address.city.id).to.be.a("number");
    expect(res.getBody().data.address.is_default).to.equal(false);
  });
}
