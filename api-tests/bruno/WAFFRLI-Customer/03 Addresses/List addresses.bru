meta {
  name: List addresses
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/customer/addresses
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("exactly one default", function () {
    expect(res.getBody().data.addresses.filter(a => a.is_default).length).to.equal(1);
  });
}
