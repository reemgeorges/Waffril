meta {
  name: List my carts
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/customer/carts
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("contains the cart", function () {
    expect(res.getBody().data.carts.map(c => String(c.id))).to.include(bru.getVar("cart_id"));
  });
}
