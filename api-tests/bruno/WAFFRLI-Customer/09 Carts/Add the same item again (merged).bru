meta {
  name: Add the same item again (merged)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/customer/cart/items
  body: json
  auth: inherit
}

body:json {
  {
    "branch_id": {{branch_id}},
    "product_id": {{product_id}},
    "quantity": 1
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("same line, quantity increased", function () {
    const items = res.getBody().data.cart.items;
    expect(items.length).to.equal(1);
    expect(items[0].quantity).to.be.greaterThan(1);
  });
}
