meta {
  name: Wallet balances (read only)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/customer/wallet
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("balances per currency", function () {
    res.getBody().data.wallets.forEach(w => expect(w).to.have.all.keys("currency", "symbol", "balance"));
  });
}
