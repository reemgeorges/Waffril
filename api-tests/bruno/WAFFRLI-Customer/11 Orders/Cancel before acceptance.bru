meta {
  name: Cancel before acceptance
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/customer/orders/{{order_id}}/cancel
  body: json
  auth: inherit
}

body:json {
  {
    "note": "Bruno test cleanup"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("cancelled", function () {
    expect(res.getBody().data.order.status).to.equal("cancelled");
  });
}
