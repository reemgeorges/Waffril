meta {
  name: Plans
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/customer/plus/plans
  body: none
  auth: inherit
}

script:post-response {
  const p = (res.getBody().data.plans || [])[0]; if (p) { bru.setVar("plan_id", String(p.id)); }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}
