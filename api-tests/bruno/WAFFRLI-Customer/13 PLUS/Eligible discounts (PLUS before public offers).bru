meta {
  name: Eligible discounts (PLUS before public offers)
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/customer/plus/eligible-discounts
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("shape", function () {
    expect(res.getBody().data).to.include.keys("has_active_cycle", "free_deliveries_remaining", "discounts");
  });
}
