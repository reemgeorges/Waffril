meta {
  name: Upload avatar
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/customer/me/avatar
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  avatar: @file(fixtures/avatar.png)
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("avatar url returned", function () {
    expect(res.getBody().data.user.avatar_url).to.be.a("string").and.not.empty;
  });
}
