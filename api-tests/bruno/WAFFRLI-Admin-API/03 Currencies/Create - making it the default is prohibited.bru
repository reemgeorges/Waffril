meta {
  name: Create - making it the default is prohibited
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/admin/currencies/create
  body: json
  auth: inherit
}

body:json {
  {
    "code": "ZZQ",
    "symbol": "Z",
    "decimals": 2,
    "exchange_rate": "1",
    "is_default": true
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  There is deliberately no API route that switches the default currency.
}
