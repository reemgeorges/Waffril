meta {
  name: Deactivate (leave test record inactive)
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/admin/delivery-areas/deactivate
  body: json
  auth: inherit
}

body:json {
  {
    "id": {{delivery_area_id}}
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  The API never deletes: the record created by this run is left inactive.
}
