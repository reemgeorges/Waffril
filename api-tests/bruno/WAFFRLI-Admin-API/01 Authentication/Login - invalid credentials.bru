meta {
  name: Login - invalid credentials
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/admin/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "definitely-not-the-password"
  }
}

tests {
  test("refused (400, 401, 422)", function () {
    expect(res.getStatus()).to.be.oneOf([400, 401, 422]);
    expect(res.getBody().status).to.equal(false);
    expect(res.getBody().data).to.equal(null);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  Generic message, no account enumeration. The starter auth layer answers 400.
}
