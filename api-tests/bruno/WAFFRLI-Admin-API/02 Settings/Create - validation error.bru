meta {
  name: Create - validation error
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/admin/settings/create
  body: json
  auth: inherit
}

body:json {
  {
    "key": "Invalid Key!",
    "value": "x"
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("first validation message", function () {
    expect(res.getBody().error).to.be.a("string").and.not.empty;
  });
}
