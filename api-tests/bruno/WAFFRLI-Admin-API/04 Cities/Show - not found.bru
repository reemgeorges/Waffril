meta {
  name: Show - not found
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/admin/cities/show
  body: json
  auth: inherit
}

body:json {
  {
    "id": 99999999
  }
}

tests {
  test("refused (400, 404)", function () {
    expect(res.getStatus()).to.be.oneOf([400, 404]);
    expect(res.getBody().status).to.equal(false);
    expect(res.getBody().data).to.equal(null);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.include.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}
