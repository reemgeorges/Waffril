meta {
  name: Location without an active delivery
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/driver/location
  body: json
  auth: inherit
}

body:json {
  {
    "lat": {{latitude}},
    "lng": {{longitude}}
  }
}

tests {
  test("HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  Runs after the delivery is completed, so the demo driver has no active delivery left.
}
