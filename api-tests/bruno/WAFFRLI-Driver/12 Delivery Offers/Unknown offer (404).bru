meta {
  name: Unknown offer (404)
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/driver/offers/999999999
  body: none
  auth: inherit
}

tests {
  test("hidden as 404 (another driver's offer looks the same)", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().data).to.equal(null);
  });
}
