meta {
  name: Report a delivery problem
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/driver/orders/{{order_id}}/problems
  body: json
  auth: inherit
}

body:json {
  {
    "type": "customer_unreachable",
    "note": "Bruno test: no answer at the door"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });

  test("reported, order not cancelled", function () {
    expect(res.getBody().data.type).to.equal("customer_unreachable");
  });
}
