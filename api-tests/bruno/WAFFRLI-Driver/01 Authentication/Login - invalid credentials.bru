meta {
  name: Login - invalid credentials
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/driver/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{driver_phone}}",
    "password": "definitely-not-the-password"
  }
}

tests {
  test("HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
  test("generic message (no account enumeration)", function () {
    expect(res.getBody().error).to.be.a("string").and.not.empty;
    expect(res.getBody().data).to.equal(null);
  });
}
