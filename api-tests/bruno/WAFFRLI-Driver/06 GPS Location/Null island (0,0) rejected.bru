meta {
  name: Null island (0,0) rejected
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/driver/location
  body: json
  auth: inherit
}

body:json {
  {
    "lat": 0,
    "lng": 0
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}
