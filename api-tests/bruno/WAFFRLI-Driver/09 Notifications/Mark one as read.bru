meta {
  name: Mark one as read
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/driver/notifications/{{notification_id}}/read
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status flag is true", function () {
    expect(res.getBody().status).to.equal(true);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });

  test("marked", function () {
    expect(res.getBody().data.notification.read_at).to.be.a("string");
  });
}
