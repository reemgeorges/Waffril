meta {
  name: Change password - wrong current password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/driver/password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "wrong-current-password",
    "password": "a-new-password-123",
    "password_confirmation": "a-new-password-123"
  }
}

tests {
  test("HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  test("status flag is false", function () {
    expect(res.getBody().status).to.equal(false);
  });

  test("standard envelope", function () {
    const b = res.getBody();
    expect(b).to.have.all.keys("data", "status", "error", "statusCode");
    expect(b.statusCode).to.equal(res.getStatus());
  });
}

docs {
  Safe example: the wrong current password is refused. A real change revokes your other tokens and requires updating your local .env.
}
