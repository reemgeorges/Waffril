    admins {
        bigint id PK
        varchar_255 name
        varchar_255 email
        timestamp email_verified_at
        varchar_255 password
        tinyint_1 is_active
        varchar_5 locale
        varchar_100 remember_token
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
    }
    currencies {
        bigint id PK
        char_3 code
        json name
        varchar_10 symbol
        tinyint decimals
        decimal_24_12 exchange_rate
        tinyint_1 is_default
        tinyint default_marker
        tinyint_1 is_active
        timestamp rate_updated_at
        bigint rate_updated_by_admin_id FK
        timestamp created_at
        timestamp updated_at
    }
    currency_redenominations {
        bigint id PK
        bigint from_currency_id FK
        bigint to_currency_id FK
        decimal_24_12 conversion_rate
        varchar_16 status
        tinyint inflight_marker
        varchar_64 idempotency_key
        bigint requested_by_admin_id FK
        timestamp started_at
        timestamp completed_at
        timestamp failed_at
        text error
        json summary
        timestamp created_at
        timestamp updated_at
    }
    plus_cycle_discounts {
        bigint id PK
        bigint plus_cycle_id FK
        bigint store_id FK
        varchar_16 source
        varchar_10 discount_type
        bigint snapshot_currency_id FK
        decimal_18_4 snapshot_discount_value
        decimal_18_4 snapshot_max_discount_amount
        decimal_18_4 snapshot_min_order_amount
        smallint max_uses_per_cycle
        bigint op_currency_id FK
        decimal_18_4 op_discount_value
        decimal_18_4 op_max_discount_amount
        decimal_18_4 op_min_order_amount
        bigint op_redenomination_id FK
        timestamp created_at
    }
    plus_cycles {
        bigint id PK
        bigint plus_membership_id FK
        bigint user_id FK
        bigint plus_plan_id FK
        bigint plus_request_id FK
        smallint cycle_number
        timestamp starts_at
        timestamp ends_at
        varchar_16 status
        bigint active_marker
        json plan_name
        varchar_16 renewal_policy
        bigint snapshot_currency_id FK
        smallint free_deliveries_total
        smallint free_deliveries_used
        bigint confirmed_by_admin_id FK
        timestamp confirmed_at
        timestamp created_at
        timestamp updated_at
    }
    plus_memberships {
        bigint id PK
        bigint user_id FK
        bigint plus_plan_id FK
        bigint next_plan_id FK
        varchar_16 renewal_policy
        smallint custom_duration_days
        smallint free_deliveries_override
        bigint override_approved_by_admin_id FK
        varchar_16 status
        bigint policy_set_by_admin_id FK
        timestamp cancelled_at
        timestamp ended_at
        timestamp created_at
        timestamp updated_at
    }
    plus_plans {
        bigint id PK
        varchar_50 code
        json name
        json description
        smallint default_duration_days
        smallint free_deliveries_per_cycle
        decimal_18_4 display_price
        tinyint_1 is_active
        int sort_order
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
    }
    plus_requests {
        bigint id PK
        bigint user_id FK
        bigint plus_membership_id FK
        varchar_16 type
        bigint requested_plan_id FK
        varchar_1000 customer_note
        varchar_16 source
        varchar_16 status
        varchar_40 pending_key
        varchar_1000 admin_note
        bigint reviewed_by_admin_id FK
        timestamp reviewed_at
        timestamp created_at
        timestamp updated_at
    }
    plus_store_discounts {
        bigint id PK
        bigint plus_plan_id FK
        bigint plus_membership_id FK
        bigint store_id FK
        tinyint_1 is_excluded
        varchar_10 discount_type
        decimal_18_4 discount_value
        decimal_18_4 max_discount_amount
        decimal_18_4 min_order_amount
        smallint max_uses_per_cycle
        bigint approved_by_admin_id FK
        varchar_255 note
        tinyint_1 is_active
        timestamp created_at
        timestamp updated_at
    }
    stores {
        bigint id PK
        json name
        varchar_120 slug
        varchar_255 logo
        json description
        varchar_16 contact_phone
        varchar_16 contact_whatsapp
        tinyint_1 is_active
        int sort_order
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
    }
    users {
        bigint id PK
        varchar_255 name
        varchar_100 first_name
        varchar_100 last_name
        varchar_255 avatar
        varchar_255 email
        timestamp email_verified_at
        varchar_255 password
        varchar_100 remember_token
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
        tinyint_1 is_active
        tinyint_1 status
        varchar_255 social_id
        varchar_10 prefix_phone
        varchar_30 phone_number
        varchar_16 phone
        varchar_255 otp_delivery_method
        timestamp activated_at
        tinyint_1 email_status
        tinyint_1 phone_status
        timestamp phone_verified_at
        varchar_10 language
        varchar_255 verified_email
        varchar_16 account_status
        timestamp suspended_at
        bigint suspended_by_admin_id FK
        varchar_255 suspension_reason
        varchar_16 otp_channel
        bigint display_currency_id FK
        timestamp profile_completed_at
        timestamp recovery_until
        timestamp anonymized_at
    }
