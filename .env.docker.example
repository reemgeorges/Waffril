# WAFFRLI — local Docker development settings (template).
# scripts/setup.ps1 (or scripts/setup.sh) copies this to .env ONLY if .env does
# not exist, then fills the EMPTY secret values below with random ones.
# Never commit .env. Never use these settings in production.

APP_NAME=WAFFRLI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Docker ports (all bound to 127.0.0.1) ---------------------------------
APP_PORT=8080
FORWARD_DB_PORT=33060
MAILPIT_UI_PORT=8025
# Your WSL user id/group (run `id -u` / `id -g` in WSL); 1000 is the default.
DOCKER_UID=1000
DOCKER_GID=1000

# --- MySQL 8 (service "mysql") ---------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=waffrli
DB_USERNAME=waffrli
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Separate database for automated tests (created on first start).
DB_TEST_DATABASE=waffrli_testing

# --- Redis (service "redis", internal only) -----------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- ONE shared Reverb server (customers, drivers and Filament) ---------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Laravel → Reverb inside the Docker network
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browsers and devices → Reverb (published on the host)
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8085
REVERB_PUBLIC_SCHEME=http
# HOST NAMES (not URLs; wildcards like *.example.com allowed) whose web pages
# may open a socket. Reverb compares the host of the Origin header, and a
# client that sends NO Origin header (some native mobile WebSocket clients)
# is refused unless this is *. Private channels are protected by signed
# channel authorization either way. See docs/waffrli/realtime-and-push.md.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Native mobile apps (no Origin header). Safe: every channel is private and
# server-authorized; browsers from other sites are still refused (4009).
REVERB_ALLOW_ORIGINLESS_CLIENTS=true

# --- Mail: everything is caught by Mailpit (http://localhost:8025) ------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@waffrli.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS / WhatsApp: fake transport, nothing is sent -------------------------
WAFFRLI_SMS_DRIVER=fake
# Development-only OTP peek (GET /api/v1/dev/otp, header X-Dev-Token). Filled by setup.
WAFFRLI_DEV_OTP_PEEK_TOKEN=

# --- Push (FCM): fake transport until real Firebase credentials exist --------
WAFFRLI_PUSH_ENABLED=true
WAFFRLI_PUSH_DRIVER=fake
WAFFRLI_PUSH_QUEUE=default
WAFFRLI_PUSH_SKIP_WHEN_ONLINE=true
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

WAFFRLI_CURRENCY_SWITCH_ENABLED=false

# --- Interactive API docs (Scalar at /docs, local only) ----------------------
WAFFRLI_API_DOCS_ENABLED=true

FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"
